generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// NEXTAUTH STANDARD MODELS
// ============================================
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// APP SPECIFIC MODELS (Agent/User)
// ============================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // Added for Credentials provider
  
  // Coway UBOS Specific Fields
  cowayId         String?   @unique
  slug            String?   @unique // cth: 'budi-santoso'
  whatsappNumber  String?
  bio             String?   @db.Text
  
  // Custom Tracking Pixels
  metaPixelId     String?
  tiktokPixelId   String?
  gtmId           String?
  
  // Status & Subscription
  isActive        Boolean   @default(true) // Langsung aktif saat daftar (Basic)
  isPremium       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Affiliate System
  referredById    String?
  referredBy      User?     @relation("AffiliateNetwork", fields: [referredById], references: [id])
  referrals       User[]    @relation("AffiliateNetwork")

  // Relations
  accounts      Account[]
  sessions      Session[]
  leads         Lead[]
  orders        Order[]
  analytics     Analytic[]
  commissions   Commission[] @relation("CommissionEarner")
  metaCampaigns MetaCampaign[]
  withdrawals   Withdrawal[] @relation("AgentWithdrawals")
}

// ============================================
// LEADS & TRANSACTIONS
// ============================================
model Lead {
  id              String    @id @default(uuid())
  agentId         String
  customerName    String
  whatsappNumber  String
  city            String?
  targetProduct   String?   // cth: 'Ombak', 'Neo Plus'
  status          String    @default("NEW") // NEW, CONTACTED, CLOSED
  createdAt       DateTime  @default(now())

  agent           User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Service {
  id              String    @id @default(uuid())
  title           String    // cth: 'Aktivasi Landing Page', 'Meta Ads'
  description     String
  price           Decimal
  isActive        Boolean   @default(true)
  orders          Order[]
}

model Order {
  id              String    @id @default(uuid())
  agentId         String
  serviceId       String
  status          String    @default("PENDING") // PENDING, PAID, PROCESSING, COMPLETED
  paymentRef      String?   // Referensi Midtrans/Xendit
  amount          Decimal
  createdAt       DateTime  @default(now())

  agent           User      @relation(fields: [agentId], references: [id])
  service         Service   @relation(fields: [serviceId], references: [id])
  commission      Commission?
  metaCampaign    MetaCampaign?
}

// ============================================
// META ADS CAMPAIGNS
// ============================================
model MetaCampaign {
  id              String    @id @default(uuid())
  orderId         String    @unique
  agentId         String
  durationDays    Int
  status          String    @default("PENDING") // PENDING, ACTIVE, COMPLETED
  startDate       DateTime?
  endDate         DateTime?
  spentBudget     Int       @default(0)
  leadsGenerated  Int       @default(0)
  reportNotes     String?   @db.Text
  reportImageUrl  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent           User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

// ============================================
// AFFILIATE COMMISSIONS
// ============================================
model Commission {
  id              String    @id @default(uuid())
  earnerId        String    // Agen yang mendapatkan komisi
  orderId         String    @unique // Transaksi yang menghasilkan komisi
  amount          Decimal   // Nominal komisi (35% dari order.amount)
  status          String    @default("PENDING") // PENDING, PAID, CANCELLED
  createdAt       DateTime  @default(now())

  earner          User      @relation("CommissionEarner", fields: [earnerId], references: [id])
  order           Order     @relation(fields: [orderId], references: [id])
}

// ============================================
// ANALYTICS
// ============================================
model Analytic {
  id              String    @id @default(uuid())
  agentId         String
  pageViews       Int       @default(0)
  whatsappClicks  Int       @default(0)
  affiliateClicks Int       @default(0)
  date            DateTime  @default(now()) @db.Date

  agent           User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@unique([agentId, date])
}

// ============================================
// DYNAMIC MENUS
// ============================================
model FeatureMenu {
  id        String   @id @default(uuid())
  name      String
  href      String
  iconName  String   @default("Circle") // Maps to Lucide React icons
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// CREATIVE ASSETS CMS
// ============================================
model CreativeAsset {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Int      @default(0)
  type        String   // e.g. "Video", "Bundle", "Image"
  fileUrl     String?  // Link rahasia akses setelah bayar
  coverUrl    String?  // Link gambar cover thumbnail
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// PAYOUT / WITHDRAWALS
// ============================================
model Withdrawal {
  id          String   @id @default(uuid())
  agentId     String
  amount      Decimal
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  bankName    String
  accountNo   String
  accountName String
  mayarRefId  String?  // Referensi transaksi dari Mayar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent       User     @relation("AgentWithdrawals", fields: [agentId], references: [id], onDelete: Cascade)
}
